+++ b/src/ObjWriting/Game/T6/GfxWorld/GfxWorldDumperT6.h
@@ -0,0 +1,19 @@
+#pragma once
+
+#include "Dumping/AbstractAssetDumper.h"
+#include "Game/T6/T6.h"
+
+namespace gfx_world
+{
+    // Dumps the raw render world: a json index of surfaces, materials and
+    // static model placements next to the untouched vertex and index buffers.
+    //   maps/mp/<name>.d3dbsp.gfxworld.json
+    //   maps/mp/<name>.d3dbsp.gfxworld.vd0
+    //   maps/mp/<name>.d3dbsp.gfxworld.vd1
+    //   maps/mp/<name>.d3dbsp.gfxworld.idx
+    class DumperT6 final : public AbstractAssetDumper<T6::AssetGfxWorld>
+    {
+    protected:
+        void DumpAsset(AssetDumpingContext& context, const XAssetInfo<T6::AssetGfxWorld::Type>& asset) override;
+    };
+} // namespace gfx_world
